{
  "name": "botwatch",
  "version": "0.3.2",
  "description": "An always-on-top pill that shows what every Claude Code session is doing.",
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "demo": "python3 -m http.server 4173",
    "test": "node --test tests/*.test.js",
    "hook": "sh tools/build-hook.sh",
    "predist": "npm run hook",
    "dist": "electron-builder --mac"
  },
  "devDependencies": {
    "electron": "^44.4.3",
    "electron-builder": "^26.15.3"
  },
  "productName": "BotWatch",
  "license": "MIT",
  "author": "Joshua Seppich <joshuatseppich@gmail.com>",
  "repository": "github.com/JoshTSeppich/botwatch",
  "build": {
    "appId": "io.github.joshtseppich.botwatch",
    "productName": "BotWatch",
    "files": [
      "electron/**/*",
      "src/**/*",
      "index.html",
      "package.json"
    ],
    "asarUnpack": [
      "electron/orchestrator/**"
    ],
    "extraResources": [
      {
        "from": "claude-plugin",
        "to": "claude-plugin",
        "filter": [
          "**/*"
        ]
      }
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "identity": null,
      "extendInfo": {
        "NSAppleEventsUsageDescription": "BotWatch needs this to see which terminal window each Claude Code session is in, and to bring one to the front when you click it.",
        "LSUIElement": true
      }
    },
    "dmg": {
      "title": "BotWatch"
    },
    "afterPack": "build/after-pack.cjs"
  },
  "engines": {
    "node": ">=20"
  }
}
